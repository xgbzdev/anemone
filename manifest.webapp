{
  "name": "Anemone",
  "description": "Theme manager",
  "version": "1.1.0",
  "launch_path": "/index.html",
  "origin": "app://anemone.themes",
  "icons": {
    "60": "/img/icon-60.png",
    "128": "/img/icon-128.png"
  },
  "developer": {
    "name": "Anemone"
  },
  "default_locale": "en",
  "type": "privileged",
  "permissions": {
    "device-storage:sdcard": {
      "description": "Read theme packs from the SD card",
      "access": "readonly"
    }
  }
}