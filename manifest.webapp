{
  "name": "Anemone",
  "description": "Theme manager: wallpaper, icons and fonts from your SD card",
  "version": "1.1.0",
  "type": "privileged",
  "launch_path": "/index.html",
  "developer": { "name": "Anemone", "url": "https://example.com" },
  "default_locale": "en",
  "icons": {
    "60": "/img/icon-60.png",
    "128": "/img/icon-128.png"
  },
  "orientation": ["portrait-primary"],
  "csp": "default-src * data: blob:; script-src 'self'; object-src 'none'; style-src 'self' 'unsafe-inline'",
  "permissions": {
    "device-storage:sdcard": { "access": "readonly", "description": "Read theme packs from the SD card" }
  }
}
